# Copy to `.env` and fill in your own credentials. `.env` is gitignored.

# --- eBay Browse API (Production) -----------------------------------------
EBAY_PRODUCTION_APP_ID=
EBAY_PRODUCTION_CERT_ID=
EBAY_PRODUCTION_DEV_ID=

# --- eBay Browse API (Sandbox, optional) ----------------------------------
EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_CERT_ID=
EBAY_SANDBOX_DEV_ID=

# --- OpenAI (optional; enables ChatGPT edition-matching filter) -----------
OPENAI_API_KEY=
